# Copy this file to .env (not committed to git) and fill in real values.
# Loaded into the container by docker-compose (env_file) and read by
# app/var/www/YT/config/config.php via getenv().

# SOCKS5 proxy used for domains outside Downloader::DIRECT_ACCESS_DOMAINS.
# Format: socks5://user:pass@host:port (leave empty to disable proxying)
SOCKS5_URL=

# Обратная связь (index.php?feedback)
# Пароль администратора: удаление сообщений/обращений и ответы от его имени.
# Можно положить готовый хеш: php -r 'echo password_hash("пароль", PASSWORD_DEFAULT), "\n";'
FEEDBACK_ADMIN_PASSWORD=
# Сети, из которых администрировать можно без пароля (CIDR, через запятую).
# Внешние адреса держи здесь, а не в config.php - этот файл в git не попадает.
FEEDBACK_ADMIN_NETWORKS=127.0.0.1/32,::1/128,192.168.1.0/24
